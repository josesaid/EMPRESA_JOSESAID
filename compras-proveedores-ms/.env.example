# Copia este archivo a .env y completa los valores. No subas .env a Git.
COMPRAS_DB_PASSWORD=
# Secreto JWT compartido con usuarios-accesos-ms (mínimo 32 caracteres)
USUARIOS_JWT_SECRET=
# Clave AES-256 en base64 (32 bytes): openssl rand -base64 32
COMPRAS_CIFRADO_CLAVE=
# Clave HMAC en base64 (mínimo 32 bytes): openssl rand -base64 32
COMPRAS_INDICE_CLAVE=
