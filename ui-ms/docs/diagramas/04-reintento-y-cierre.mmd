flowchart TD
  A["<b>Llamada a una API</b><br/>ejecutar()"]:::actor --> B["<b>Llama con el token vigente</b>"]:::servicio
  B -- "éxito" --> C["<b>Respuesta</b>"]:::datos
  B -- "otro error" --> G["<b>Se propaga el error</b>"]:::alerta
  B -- "401" --> D["<b>Renueva la sesión una vez</b>"]:::servicio
  D -- "la renovación falla" --> E["<b>Sesión expirada</b>"]:::alerta
  D -- "la renovación funciona" --> F["<b>Repite la llamada una sola vez</b>"]:::servicio
  K["<b>POST /logout</b>"]:::actor --> L["<b>POST auth/logout en usuarios-accesos</b><br/>Con el refresh token"]:::servicio
  L -- "falla" --> M["<b>Se registra un aviso</b>"]:::pendiente
  L -- "éxito" --> N["<b>Invalida la sesión local</b>"]:::datos
  M --> N
  N --> O["<b>Redirige a /login?salir</b>"]:::servicio

  classDef actor fill:#F1EFE8,stroke:#888780,color:#2C2C2A
  classDef servicio fill:#E1F5EE,stroke:#1D9E75,color:#04342C
  classDef datos fill:#E6F1FB,stroke:#378ADD,color:#042C53
  classDef alerta fill:#FCEBEB,stroke:#E24B4A,color:#501313
  classDef pendiente fill:#FAEEDA,stroke:#BA7517,color:#412402
