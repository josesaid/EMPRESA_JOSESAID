flowchart TD
  A["<b>accessTokenVigente()</b><br/>Faltan menos de 60 s?"]:::actor --> B{"<b>Vence pronto?</b>"}:::pendiente
  B -- "no" --> C["<b>Usa el access token actual</b>"]:::servicio
  B -- "sí" --> D{"<b>Lock de la sesión en Redis</b><br/>Espera hasta 5 s"}:::pendiente
  D -- "no lo consigue a tiempo" --> E["<b>Renueva sin lock</b><br/>Mejor esfuerzo"]:::alerta
  D -- "lo consigue" --> F{"<b>Otra petición ya renovó?</b>"}:::pendiente
  F -- "sí, el almacén tiene otro token" --> G["<b>Adopta el token renovado</b><br/>No usa el refresh token viejo"]:::datos
  F -- "no" --> H["<b>POST auth/refresh</b><br/>Con el refresh token"]:::actor
  E --> H
  H --> I["<b>Actualiza los tokens de la sesión</b>"]:::datos

  classDef actor fill:#F1EFE8,stroke:#888780,color:#2C2C2A
  classDef servicio fill:#E1F5EE,stroke:#1D9E75,color:#04342C
  classDef datos fill:#E6F1FB,stroke:#378ADD,color:#042C53
  classDef alerta fill:#FCEBEB,stroke:#E24B4A,color:#501313
  classDef pendiente fill:#FAEEDA,stroke:#BA7517,color:#412402
