# Copie este archivo a .env y reemplace los valores. Nunca suba .env al repositorio.

# Superusuario de PostgreSQL
POSTGRES_PASSWORD=

# Contraseña de la base de datos y el usuario "clientes". Debe coincidir con CLIENTES_DB_PASSWORD de clientes-ms/.env
CLIENTES_DB_PASSWORD=

# Base de datos y usuario "usuarios_accesos". Debe coincidir con DB_PASSWORD en usuarios-accesos-ms
USUARIOS_ACCESOS_DB_PASSWORD=

# Clave RSA privada (PKCS#8 DER en Base64) para firmar JWT de usuarios-accesos-ms. Genérela con: openssl genpkey -algorithm RSA -pkeyopt rsa_keygen_bits:2048 -outform DER | base64 | tr -d '
'
USUARIOS_JWT_CLAVE_PRIVADA=
USUARIOS_JWT_KID=empresa-usuarios-1
USUARIOS_JWT_CLAVE_PUBLICA_ANTERIOR=
USUARIOS_JWT_KID_ANTERIOR=

# Administrador inicial opcional de usuarios-accesos-ms (se crea solo si el correo no existe)
USUARIOS_ADMIN_INICIAL_CORREO=
USUARIOS_ADMIN_INICIAL_PASSWORD=

# Contraseña del usuario facturacion_pagos (facturacion-pagos-ms)
FACTURACION_DB_PASSWORD=

# Contraseña del usuario contabilidad (contabilidad-ms)
CONTABILIDAD_DB_PASSWORD=

# Contraseña del usuario inventario (inventario-operaciones-ms)
INVENTARIO_DB_PASSWORD=

# Contraseña del usuario compras (compras-proveedores-ms)
COMPRAS_DB_PASSWORD=

# Contraseña del usuario pedidos (pedidos-ventas-ms)
PEDIDOS_DB_PASSWORD=

# Contraseña del usuario documentos (documentos-cumplimiento-ms)
DOCUMENTOS_DB_PASSWORD=

# Clave AES-256 en base64 para cifrar archivos legales. Respáldela.
DOCUMENTOS_CIFRADO_CLAVE=

# Contraseña del usuario reportes (reportes-ejecutivos-ms)
REPORTES_DB_PASSWORD=

# Usuario y contraseña del panel y registro de Eureka (discovery-ms). Obligatorios para levantar los servicios.
EUREKA_USUARIO=
EUREKA_PASSWORD=

# Contraseña del usuario admin de Grafana (monitoreo)
GRAFANA_ADMIN_PASSWORD=
