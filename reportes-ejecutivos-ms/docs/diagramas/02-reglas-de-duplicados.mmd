flowchart TD
  A["<b>Indicador entrante</b><br/>Área, nombre y periodo"]:::actor --> B{"<b>Ya existe esa combinación?</b>"}:::pendiente
  B -- "no" --> C["<b>Crea el indicador</b>"]:::servicio
