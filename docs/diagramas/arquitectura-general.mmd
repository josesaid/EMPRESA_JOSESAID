  classDef datos fill:#E6F1FB,stroke:#378ADD,color:#042C53
  classDef alerta fill:#FCEBEB,stroke:#E24B4A,color:#501313
  classDef pendiente fill:#FAEEDA,stroke:#BA7517,color:#412402
  classDef infra fill:#FFF8DC,stroke:#E0A800,color:#4A3800
  classDef seguridad fill:#FDF0E1,stroke:#E8870E,color:#4A2A00
  classDef cifrado fill:#FDEEF3,stroke:#D4537E,color:#4B1528
  classDef dominio fill:#F6EEFB,stroke:#AF52DE,color:#3A1450
