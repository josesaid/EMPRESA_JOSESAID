flowchart TD
  A["<b>Usuario crea cotización o pedido</b><br/>Con clienteId y su propio token"]:::actor --> B["<b>pedidos-ventas-ms</b><br/>GET /v1/clientes/{id} en clientes-ms"]:::servicio
  B --> C{"<b>Respuesta de clientes-ms</b>"}:::pendiente
  C -- "404" --> E1["<b>422 regla-de-negocio</b><br/>El cliente no existe"]:::alerta
  C -- "error, timeout o respuesta inválida" --> E2["<b>503 servicio-no-disponible</b><br/>Reintentar; no se guarda nada"]:::alerta
  C -- "200 con estatus distinto de ACTIVO" --> E3["<b>422 regla-de-negocio</b><br/>El cliente no está activo<br/>SUSPENDIDO o BAJA"]:::alerta
  C -- "200 con estatus ACTIVO" --> OK["<b>La operación continúa</b><br/>Se crea el pedido"]:::servicio

  classDef actor fill:#F1EFE8,stroke:#888780,color:#2C2C2A
  classDef servicio fill:#E1F5EE,stroke:#1D9E75,color:#04342C
  classDef datos fill:#E6F1FB,stroke:#378ADD,color:#042C53
  classDef alerta fill:#FCEBEB,stroke:#E24B4A,color:#501313
  classDef pendiente fill:#FAEEDA,stroke:#BA7517,color:#412402
