flowchart TD
  A["<b>Emisión de comprobante</b>"]:::actor --> B{"<b>Folio ya existe?</b><br/>Único en base de datos"}:::pendiente
  B -- "sí" --> E1["<b>Conflicto</b><br/>No se emite"]:::alerta
  B -- "no" --> C["<b>Folio FAC- asignado</b>"]:::servicio
  P["<b>Registro de pago</b>"]:::actor --> Q{"<b>Lleva Idempotency-Key?</b>"}:::pendiente
  Q -- "sí" --> R["<b>Deduplicado</b><br/>Misma clave y cuerpo: misma respuesta"]:::servicio
  Q -- "no" --> S["<b>Sin deduplicación</b><br/>Dos envíos iguales registran dos pagos"]:::alerta

  classDef actor fill:#F1EFE8,stroke:#888780,color:#2C2C2A
  classDef servicio fill:#E1F5EE,stroke:#1D9E75,color:#04342C
  classDef datos fill:#E6F1FB,stroke:#378ADD,color:#042C53
  classDef alerta fill:#FCEBEB,stroke:#E24B4A,color:#501313
  classDef pendiente fill:#FAEEDA,stroke:#BA7517,color:#412402
