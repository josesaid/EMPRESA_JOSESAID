flowchart LR
  E(["<b>Aplicaciones y gateway-ms</b>"]):::actor
  D["<b>discovery-ms</b><br/>Eureka"]:::actor
  subgraph SVC["clientes-ms · 8080 interno (8101 en tu Mac)"]
    API["<b>API REST /v1</b><br/>ControladorREST"]:::gateway
    SEG["<b>Seguridad JWT</b><br/>roles por método"]:::seguridad
    APP["<b>Servicio de aplicación</b><br/>casos de uso"]:::servicio
    CIF["<b>Cifrado AES-256-GCM</b><br/>Índice HMAC"]:::cifrado
    REP["<b>Repositorios JPA</b><br/>migraciones Flyway"]:::infra
    OUT["<b>Outbox</b><br/>outbox_eventos"]:::infra
    subgraph DOM["Dominio DDD (agregados y reglas)"]
      DM1["Cliente"]:::dominio
      DM2["Prospecto"]:::dominio
      DM3["Contacto"]:::dominio
      DM4["Interaccion"]:::dominio
      DM5["Consentimiento"]:::dominio
    end
  end
  DB[("<b>PostgreSQL</b><br/>base clientes")]:::datos
  K[["<b>Kafka</b>"]]:::alerta

  E --> API
  API --> APP
  API -.- SEG
  APP --> CIF
  APP --> REP
  CIF -.- REP
  REP --> DB
  APP --> OUT
  OUT --> K
  APP --> DOM
  D -. "registro" .-> APP

