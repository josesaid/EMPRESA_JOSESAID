flowchart TD
  A["<b>Alta de prospecto o cliente</b><br/>Con RFC, correo o nombre"]:::actor --> B{"<b>RFC igual a un cliente</b><br/>no dado de baja?"}:::pendiente
  B -- "sí" --> E1["<b>Rechazo 409 rfc-duplicado</b><br/>No hay confirmación posible"]:::alerta
  B -- "no" --> C{"<b>Correo, nombre o razón social parecidos?</b><br/>Prospectos, contactos y clientes"}:::pendiente
  C -- "no" --> OK["<b>Alta permitida</b>"]:::servicio
  C -- "sí" --> D{"<b>confirmarDuplicado=true?</b>"}:::pendiente
  D -- "no" --> E2["<b>409 posible-duplicado</b><br/>Lista de coincidencias"]:::alerta
  D -- "sí" --> M["<b>Métrica clientes.duplicados.detectados</b><br/>Se registra y se permite la alta"]:::datos
  M --> OK

  classDef actor fill:#F1EFE8,stroke:#888780,color:#2C2C2A
