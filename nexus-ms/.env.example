# Variables de nexus-ms. Copiar a .env y completar. Nunca subir .env con valores reales.
SERVER_PORT=8081
JWT_JWKS_URI=http://usuarios-accesos-ms:8081/.well-known/jwks.json
# Proveedor de modelo: API key de la cuenta de Claude de la empresa (nunca subir el valor real)
ANTHROPIC_API_KEY=
NEXUS_MODELO=claude-sonnet-5-5
GATEWAY_URL=http://gateway-ms:8080
# Límites por pregunta: tiempo máximo por llamada al modelo, reintentos y herramientas por pregunta
NEXUS_MODELO_TIMEOUT=20s
NEXUS_MODELO_REINTENTOS=1
NEXUS_MAX_HERRAMIENTAS=4
# Base de datos propia de nexus-ms (la crea infra/postgres/init-databases.sh)
NEXUS_DB_URL=jdbc:postgresql://postgres:5432/nexus
NEXUS_DB_USER=nexus
NEXUS_DB_PASSWORD=
