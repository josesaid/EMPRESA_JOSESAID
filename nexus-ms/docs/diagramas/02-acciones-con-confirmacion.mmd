flowchart TD
  A["<b>Preparar</b><br/>Valida con el token del usuario"]:::actor --> B["<b>PENDIENTE</b><br/>Vigencia de 10 minutos<br/>Devuelve accion_id y resumen"]:::servicio
  B -- "consulta después de vencer" --> C["<b>EXPIRADA</b>"]:::alerta
  B -- "confirmar" --> D{"<b>Ejecuta en el servicio dueño</b>"}:::pendiente
  D -- "la ejecución falla" --> B
  D -- "ejecuta bien" --> E["<b>CONFIRMADA</b>"]:::datos
  B -- "cancelar" --> F["<b>CANCELADA</b><br/>Sin ejecutar"]:::alerta
  G["<b>Otro usuario</b>"]:::actor -. "consultar, confirmar o cancelar" .-> H["<b>404</b>"]:::alerta

  classDef actor fill:#F1EFE8,stroke:#888780,color:#2C2C2A
