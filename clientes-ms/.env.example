# Copie este archivo a .env y reemplace los valores. Nunca suba .env al repositorio.

# Contraseña del usuario "clientes" en PostgreSQL. Debe coincidir con CLIENTES_DB_PASSWORD de la raíz.
CLIENTES_DB_PASSWORD=

# Clave AES-256 en Base64 (32 bytes). Generar con: openssl rand -base64 32
CRYPTO_CLAVE_CIFRADO=

# Clave HMAC-SHA256 en Base64 (32 bytes), distinta de la anterior. Generar con: openssl rand -base64 32
CRYPTO_CLAVE_INDICE=

# Emisor de los tokens JWT (servicio de Usuarios y Accesos)
JWT_ISSUER_URI=https://usuarios.empresa.mx
