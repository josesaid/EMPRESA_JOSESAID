# Variables del servicio usuarios-accesos-ms.
# Copia este archivo a .env y reemplaza los valores. NUNCA subas .env al repositorio.

# Base de datos (PostgreSQL compartido de la raíz; ver infra/postgres/init-databases.sh)
DB_URL=jdbc:postgresql://postgres:5432/usuarios_accesos
DB_USER=usuarios_accesos
# Contraseña de la base de datos. Debe coincidir con USUARIOS_ACCESOS_DB_PASSWORD de la raíz.
DB_PASSWORD=cambia_esta_contrasena

# Kafka compartido de la raíz
KAFKA_BOOTSTRAP=kafka:9092

# Clave HMAC para firmar JWT. Mínimo 32 caracteres. Genera una con: openssl rand -base64 48
JWT_SECRET=cambia_por_una_clave_de_al_menos_32_caracteres
# Vida del token de acceso
JWT_DURACION=PT15M
JWT_EMISOR=usuarios-accesos-ms

# Puerto HTTP del servicio en el host
SERVER_PORT=8081
