flowchart TD
  A["<b>POST /v1/movimientos</b><br/>Con Idempotency-Key"]:::actor --> B{"<b>La clave ya existe?</b>"}:::pendiente
  B -- "no" --> C["<b>Registra el movimiento</b>"]:::servicio
  C -- "éxito" --> D["<b>Guarda la respuesta 24 horas</b><br/>Tabla idempotencia"]:::datos
  C -- "falla" --> F["<b>Libera la clave</b><br/>El cliente puede reintentar"]:::alerta
  B -- "sí, la original ya terminó" --> G{"<b>Mismo cuerpo?</b>"}:::pendiente
  G -- "sí" --> H["<b>Misma respuesta original</b><br/>No se crea nada nuevo"]:::servicio
  G -- "no" --> E1["<b>422</b><br/>La clave ya se usó con otro cuerpo"]:::alerta
  B -- "sí, sigue en proceso" --> I{"<b>Pasaron 2 minutos?</b>"}:::pendiente
  I -- "no" --> E2["<b>409</b><br/>La petición sigue en proceso"]:::alerta
  I -- "sí" --> J["<b>Retoma con la misma clave</b>"]:::servicio
  A -. "sin cabecera" .-> K["<b>Se procesa como siempre</b>"]:::actor

  classDef actor fill:#F1EFE8,stroke:#888780,color:#2C2C2A
